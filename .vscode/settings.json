{
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "package",
  "go.formatTool": "goimports",
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // Owned by scripts/sync-upstream.sh. Saving these — a formatter especially —
  // is undone by the next sync. First-party code (logqlmodel/, the root *.go)
  // stays writable.
  "files.readonlyInclude": {
    "syntax/**": true,
    "log/**": true,
    "internal/util/regex.go": true,
    "internal/util/matchers.go": true,
    "internal/util/encoding/encoding.go": true,
    "internal/constants/variants.go": true,
    "LICENSE": true
  }
}
